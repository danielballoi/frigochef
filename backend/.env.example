# FrigoChef backend - variabili d'ambiente (tutte facoltative: questi sono i predefiniti).
# Nessun segreto: il backend non usa chiavi o password.

# Porta HTTP
PORT=3000

# Provider di visione: mock (risposta finta, senza modello) oppure ollama
VISION_PROVIDER=mock

# Indirizzo di Ollama (usato solo con VISION_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Modello di visione in Ollama
VISION_MODEL=qwen3-vl:4b

# Tempo massimo di riconoscimento di una foto, in millisecondi
VISION_TIMEOUT_MS=90000

# Dimensione massima di ogni foto, in MB
MAX_IMAGE_MB=5

# Numero massimo di foto (ripiani) per analisi, esposto al frontend da /api/config
MAX_PHOTOS=8

# Dispensa predefinita (ingredienti separati da virgola)
PANTRY_DEFAULT=sale,pepe,olio d'oliva,zucchero,pasta,riso,farina,aceto,acqua

# Richieste di riconoscimento al minuto per IP
RATE_LIMIT_PER_MIN=20

# Livello dei log: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
