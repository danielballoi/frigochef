# FrigoChef backend - variabili d'ambiente (tutte facoltative: questi sono i predefiniti).
# Copia in .env (mai in git): `npm run dev` e `npm start` lo leggono se esiste.
# Unico segreto: GEMINI_API_KEY, obbligatoria solo con VISION_PROVIDER=gemini.

# Porta HTTP
PORT=3000

# Provider di visione: mock (risposta finta, senza modello), gemini (Google Gemini, cloud)
# oppure ollama (modello locale, adatto solo a macchine con GPU)
VISION_PROVIDER=mock

# Chiave dell'API Gemini (https://aistudio.google.com/apikey). Non scriverla qui: mettila solo in .env
GEMINI_API_KEY=

# Modello Gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Indirizzo di Ollama (usato solo con VISION_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Modello di visione in Ollama (usato solo con VISION_PROVIDER=ollama)
VISION_MODEL=qwen3-vl:4b

# Tempo massimo di riconoscimento di una foto, in millisecondi
VISION_TIMEOUT_MS=90000

# Dimensione massima di ogni foto, in MB
MAX_IMAGE_MB=5

# Numero massimo di foto (ripiani) per analisi, esposto al frontend da /api/config
MAX_PHOTOS=8

# Dispensa predefinita (ingredienti separati da virgola)
PANTRY_DEFAULT=sale,pepe,olio d'oliva,zucchero,pasta,riso,farina,aceto,acqua

# Richieste di riconoscimento al minuto per IP
RATE_LIMIT_PER_MIN=20

# Livello dei log: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
